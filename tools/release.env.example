# Machine-local release settings. Copy this to tools/release.env and fill it
# in. tools/release.env is gitignored: it names your own hosts, so it lives
# only on the machine that publishes and is never committed.
#
#   cp tools/release.env.example tools/release.env
#
# NOT a place for secrets. Tokens come from the environment only
# (GITLAB_TOKEN / GITHUB_TOKEN); a file containing one is refused.

# The GitLab server and the project's namespace path, as in its clone URL
# (not necessarily the display name shown in the web UI breadcrumb).
GITLAB_HOST=gitlab.example.com
GITLAB_PROJECT=group/subgroup/project

# Optional: also attach release files to this GitHub repository's Release.
GITHUB_REPO=owner/repo

# Optional: extra strings that must never appear anywhere in the public
# tree, comma-separated -- internal hostnames, project codenames, a
# machine's hostname. tools/checks/privacy.sh fails if it finds one.
# (GITLAB_HOST and GITLAB_PROJECT above are checked automatically.)
PRIVATE_STRINGS=
